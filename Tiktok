import os
import sys
import requests

RAW_URL = "https://raw.githubusercontent.com/mamistar/Tiktok-datas/main/Data%20gmail"
CACHE_FILE = "data_gmail.txt"

def download_data():
    if os.path.exists(CACHE_FILE):
        with open(CACHE_FILE, "r", encoding="utf-8", errors="ignore") as f:
            return f.readlines()
            
    try:
        r = requests.get(RAW_URL, timeout=15)
        if r.status_code == 200:
            lines = r.text.splitlines()
            with open(CACHE_FILE, "w", encoding="utf-8") as f:
                f.write(r.text)
            return lines
        else:
            return []
    except:
        return []

def search_data(lines, target_user, target_email):
    found_user = None
    found_email = None
    
    t_user = target_user.strip().lower() if target_user else None
    t_mail = target_email.strip().lower() if target_email else None

    for line in lines:
        line = line.strip()
        if not line or ":" not in line:
            continue
            
        parts = line.split(":", 1)
        identifier = parts[0].strip()
        second_part = parts[1].strip()
        
        if t_user and second_part.lower() == t_user:
            found_user = {"gmail": identifier, "user": second_part}

        if t_mail and identifier.lower() == t_mail:
            found_email = {"gmail": identifier, "user": second_part}

    return found_user, found_email

