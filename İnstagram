import os
import sys
import urllib.request
import time
import re

# VERİTABANI
RAW_URL = "https://files.catbox.moe/5asrk9.sql"
CACHE_FILE = "instagram_cache.sql"

def download_data():
    if os.path.exists(CACHE_FILE):
        try:
            os.remove(CACHE_FILE)
        except:
            pass

    print("Veritabanı indiriliyor, lütfen bekle...")
    try:
        req = urllib.request.Request(RAW_URL, headers={'User-Agent': 'Mozilla/5.0'})
        with urllib.request.urlopen(req, timeout=60) as response:
            data = response.read().decode('utf-8', errors='ignore')
            
            if "404: Not Found" in data or "<html" in data.lower():
                print("\nHata: Link bulunamadı veya dosya bozuk!")
                return []
                
            lines = data.splitlines()
            with open(CACHE_FILE, "w", encoding="utf-8") as f:
                f.write(data)
            return lines
    except Exception as e:
        print(f"\nHata: Veri indirilemedi! ({e})")
        return []

def parse_sql(lines):
    records = []
    pattern = re.compile(r"VALUES\s*\(\s*'([^']*)'\s*,\s*'([^']*)'\s*,\s*'([^']*)'\s*,\s*'([^']*)'\s*,\s*'([^']*)'\s*,\s*'([^']*)'\s*,\s*'([^']*)'\s*\)", re.IGNORECASE)
    
    current_insert = ""
    for line in lines:
        current_insert += " " + line.strip()
        if ";" in line:
            match = pattern.search(current_insert)
            if match:
                records.append({
                    "id": match.group(1),
                    "username": match.group(2),
                    "gsm": match.group(3),
                    "adres": match.group(4),
                    "email": match.group(5),
                    "kadi": match.group(6),
                    "engel": match.group(7)
                })
            current_insert = ""
    return records

def search_data(records, target_type, target_value):
    target_value = target_value.strip().lower()
    
    for r in records:
        if target_type == "id" and target_value in r["id"].lower():
            return r
        elif target_type == "user" and (target_value in r["username"].lower() or target_value in r["kadi"].lower()):
            return r
        elif target_type == "email" and target_value in r["email"].lower():
            return r
        elif target_type == "gsm" and target_value in r["gsm"].lower():
            return r
                
    return None

def print_record(r):
    print("==================================================")
    print(f"İD        : {r['id']}")
    print(f"Username  : {r['username']}")
    print(f"GSM       : {r['gsm'] if r['gsm'] else 'None'}")
    print(f"Adres     : {r['adres'] if r['adres'] else 'None'}")
    print(f"E-posta   : {r['email'] if r['email'] else 'None'}")
    print(f"K-Adı     : {r['kadi'] if r['kadi'] else 'None'}")
    print("==================================================")

def print_none():
