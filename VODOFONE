        elif secim == '2':
            clear_screen()
            print("-- FULL LOG (TÜM VERİLER) --\n")
            bulunan_sayisi = 0
            for kisi in parcalar:
                bulunan_sayisi += 1
                detay = [d.strip() for d in kisi.split(",")]

                print("==================================================")
                print(f"Kayıt #{bulunan_sayisi}")
