        """)
        print("==================================================")
        print("(1) Ad Soyad Ara")
        print("(2) Full Log")
        print("(q) Çıkış\n")
        print("==================================================")

        secim = input("Seçim: ").strip().lower()

        if secim == 'q':
            print("Programdan çıkılıyor...")
            break

        elif secim == '1':
            clear_screen()
            print("-- AD SOYAD ARAMA --")
            ad = input("Ad (Opsiyonel): ").strip().upper()
            soyad = input("Soyad (Opsiyonel): ").strip().upper()
            il = input("İl (Opsiyonel): ").strip().upper()
            ilce = input("İlçe (Opsiyonel): ").strip().upper()

            if not any([ad, soyad, il, ilce]):
                continue

            print("\nVeritabanında Aranıyor...\n")
            bulunan_sayisi = 0

            for kisi in parcalar:
                if (not ad or ad in kisi) and (not soyad or soyad in kisi) and (not il or il in kisi) and (not ilce or ilce in kisi):
                    bulunan_sayisi += 1
                    detay = [d.strip() for d in kisi.split(",")]

                    print("==================================================")
                    print(f"Bulundu √ (#{bulunan_sayisi})")
                    if detay: print(f"Adı Soyadı : {detay[0]}")
                    if len(detay) > 1: print(f"Abone No   : {detay[1]}")
                    if len(detay) > 6:
                        print(f"Paket Detay: {detay[2]}, {detay[3]}, {detay[4]}, {detay[5]}, {detay[6]}")
