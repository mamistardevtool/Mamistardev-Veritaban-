import re
import os
import urllib.request

# VODOFONE VERİTABANI
GIST_URL = "https://gist.githubusercontent.com/mamistardevtool/cd76176cfe47aeeefe8c1dd78670797e/raw"

def veriyi_cek():
    try:
        req = urllib.request.Request(GIST_URL, headers={"User-Agent": "Mozilla/5.0"})
        with urllib.request.urlopen(req, timeout=20) as resp:
            return resp.read().decode("utf-8", errors="replace")
    except Exception as e:
        print(f"Veri çekilemedi: {e}")
        return ""

def clear_screen():
    os.system('cls' if os.name == 'nt' else 'clear')
    print('\033c', end='')

def main():
    VERI = veriyi_cek()
    if not VERI:
        input("Gist'ten veri alınamadı. Enter'a bas...")
        return

    temiz_veri = re.sub(r'1\),\(2147483647,', '', VERI)
    temiz_veri = temiz_veri.upper()

    parcalar = re.split(r',(?=\d{10},)', temiz_veri)

    while True:
        clear_screen()
        print("""
