import sys
import json
import urllib.request
import os
import time

GIST_ID     = "26cab481ed99d5548d391cbc1a56deba"
GIST_API    = f"https://api.github.com/gists/{GIST_ID}"
YEREL_DOSYA = "gist_raw.txt"

BANNER = r"""
██████╗  █████╗ ██████╗  █████╗ ██████╗  █████╗ 
██╔══██╗██╔══██╗██╔══██╗██╔══██╗██╔══██╗██╔══██╗
