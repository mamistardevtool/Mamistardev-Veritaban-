        elif secim == '2':
            clear_screen()
            print("-- FULL LOG (TÜM VERİLER) --\n")
            bulunan_sayisi = 0
            for kisi in parcalar:
                bulunan_sayisi += 1
                detay = [d.strip() for d in kisi.split(",")]
                
                print("==================================================")
                print(f"Kayıt #{bulunan_sayisi}")
                print(f"Adı Soyadı : {detay[0]}")
                if len(detay) > 1: print(f"Abone No   : {detay[1]}")
                if len(detay) > 6:
                    print(f"Paket Detay: {detay[2]}, {detay[3]}, {detay[4]}, {detay[5]}, {detay[6]}")
                if len(detay) > 7: print(f"E-Posta    : {detay[7]}")
                if len(detay) > 8: print(f"Adres      : {detay[8]}")
                if len(detay) > 9: print(f"İl/İlçe    : {', '.join(detay[9:])}")
                print("==================================================")
            
            print(f"\nToplam {bulunan_sayisi} kayıt listelendi.")
            input("\nAna menüye dönmek için Enter'a bas...")
            
        else:
            print("Geçersiz seçim.")
            input("Ana menüye dönmek için Enter'a bas...")

